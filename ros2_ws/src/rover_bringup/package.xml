<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>2.0.0</version>
  <description>MISSION X launch files (real robot on the Raspberry Pi 4, simulator, ground-station bridge, teleop), robot_localization EKF configuration, udev rules and RViz configuration.</description>
  <maintainer email="missionx.rover@example.com">MISSION X Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_hardware</exec_depend>
  <exec_depend>rover_sim</exec_depend>
  <exec_depend>rover_slam</exec_depend>
  <exec_depend>rover_navigation</exec_depend>
  <exec_depend>rover_mission</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>hls_lfcd_lds_driver</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
