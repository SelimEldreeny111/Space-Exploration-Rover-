<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_slam</name>
  <version>2.0.0</version>
  <description>slam_toolbox (online async) configuration and launch for the MISSION X rover with the LDS-01 LiDAR. Replaces the ROS 1 hector_slam setup (hector_slam is not ported to ROS 2).</description>
  <maintainer email="missionx.rover@example.com">MISSION X Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
